# Secret partage avec Make.com (header Authorization: Bearer <INBOUND_SECRET>).
# Generer avec: openssl rand -hex 32
INBOUND_SECRET=

# GreenCity ERP
GREENCITY_API_URL=https://greencity.erp.iwit.pro
GREENCITY_API_KEY=
GREENCITY_API_SECRET=

# Noms exacts des programmes a associer a chaque lead Facebook (separes par des virgules).
# Resolus en IDs numeriques via GET /api/lead/residences cote GreenCity.
GREENCITY_RESIDENCE_NAMES=L'Archipel,Home Spirit 2,Revelation

# Brevo — upsert de chaque lead FB dans la liste "Tous leads" avec attribut TEMPERATURE.
# Cle Transactional API Brevo (compte Brevo, section SMTP & API).
BREVO_API_KEY=
# ID numerique de la liste "Tous leads" dans Brevo (registre CRM, sans workflow).
BREVO_ALL_LEADS_LIST_ID=

# Dev/test : si "true", skip l'appel GreenCity (Brevo reste appele). Ne pas activer en prod.
DRY_RUN_GREENCITY=
